{
  "name": "@hathq/hatter-console",
  "version": "0.10.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": "^22.0.0 || ^24.0.0",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "build": "node scripts/build-delivery.mjs && node scripts/stage-projection-runtime.mjs && node scripts/build-launcher.mjs && node scripts/verify-build-budget.mjs",
    "release:stage": "node scripts/stage-release.mjs",
    "release:verify": "node scripts/verify-release.mjs",
    "size:verify": "node scripts/verify-build-budget.mjs",
    "start": "./bin/hatter-console",
    "test": "node --test test/*.test.mjs",
    "test:e2e": "node test/product-root-browser.mjs",
    "test:public": "node scripts/test-public.mjs",
    "test:owner-source": "node --test test/management-protocol-projection.test.mjs test/protocol-contract.test.mjs test/repository-identity.test.mjs test/rpc-policy.test.mjs"
  },
  "dependencies": {
    "@hathq/delivery-server": "0.10.0",
    "@hathq/delivery-client": "0.10.0",
    "@hathq/delivery-contracts": "0.10.0",
    "@zixcel/dom-renderer": "0.10.0",
    "@zixcel/projection-contracts": "0.10.0",
    "@zixcel/projection-client": "0.10.0",
    "@zixcel/projection-runtime": "0.10.0",
    "@crowsi/transport-foundation": "0.10.0",
    "@crowsi/browser-security": "0.10.0",
    "@zixcel/interaction": "0.10.1",
    "@hathq/ihat-store-core": "0.10.0",
    "@hathq/ihat-store-source": "0.10.0",
    "@hathq/ihat-store-scenes": "0.10.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "esbuild": "0.28.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "description": "Hatter-owned framework-neutral Scene delivery site"
}
