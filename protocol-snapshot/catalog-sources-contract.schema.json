{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hathq://hatter-console/catalog-sources/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "revision", "selectedSourceId", "sources"],
  "properties": {
    "schema": { "const": "hathq://hatter-console/catalog-sources/v1" },
    "revision": { "type": "integer", "minimum": 0 },
    "selectedSourceId": { "$ref": "#/$defs/token" },
    "sources": { "type": "array", "minItems": 1, "maxItems": 16,
      "items": { "$ref": "#/$defs/source" } }
  },
  "$defs": {
    "token": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{0,126}[a-z0-9])?$" },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["sourceId", "label", "kind", "logicalOrigin", "signingKeyId", "publicKeyFingerprint", "locationSummary", "selected"],
      "properties": {
        "sourceId": { "$ref": "#/$defs/token" },
        "label": { "type": "string", "minLength": 1, "maxLength": 100 },
        "kind": { "enum": ["https", "local_directory"] },
        "logicalOrigin": { "type": "string", "format": "uri", "maxLength": 2048 },
        "signingKeyId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "publicKeyFingerprint": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
        "locationSummary": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "selected": { "type": "boolean" }
      }
    }
  }
}
